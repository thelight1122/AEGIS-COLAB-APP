*.pyc

# Root-level debug screenshots (manual capture during dev)
/*.png

# Browser-storage forensic / recovery dumps (LevelDB; contain live tokens — never version)
var/browser-storage-forensic-*/
var/browser-storage-recovery-*/
*.ldb
