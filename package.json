{
  "name": "aegis-colab-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:app": "vite",
    "dev:server": "tsx --env-file=.env.local server/index.ts",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:app\"",
    "dev:full": "concurrently -k \"npm run dev\" \"npm run dev --prefix e:/Git_Repository/AEGIS-AGENTIC-PLATFORMS/aegis-bm-platform\"",
    "build:tsc": "tsc",
    "build:vite": "vite build",
    "build": "run-s build:tsc build:vite",
    "kill-aegis": "npx kill-port 5173 5174 5175 4000 8787 8788 8789 8790 8791",
    "lint": "eslint .",
    "test:unit": "vitest run src/core/sessions/sessionStore.test.ts src/core/mcp/governedOperation.test.ts src/core/mcp/governedToolConduit.test.ts src/core/auth/useAuthSession.test.ts src/core/commons/session.test.ts src/core/peers/orientation.test.ts src/components/ui/AuthPanel.test.tsx src/pages/AuthCallbackPage.test.tsx",
    "test:steward": "vitest run server/__tests__/steward-scanners.test.ts server/__tests__/steward-conscience.test.ts server/__tests__/steward-pipeline.test.ts server/__tests__/mirror-pressure.test.ts server/__tests__/ibl.test.ts server/__tests__/centrifuge.test.ts server/__tests__/sigil-vrp.test.ts server/__tests__/ate.test.ts server/__tests__/advocate.test.ts server/__tests__/bookcase.test.ts server/__tests__/peer-spine-promoter.test.ts",
    "test:governance": "node scripts/runPlaywright.mjs governance",
    "test:sessions": "node scripts/runPlaywright.mjs sessions",
    "test:e2e": "run-s test:governance test:sessions",
    "test:report": "playwright show-report --port=0",
    "test:report:latest": "echo Specify a run folder to show report for, or run 'npx playwright show-report e:/AEGIS-COLAB-APP/test-results/playwright/<suite>/<runId>'",
    "test:all": "run-s lint test:unit test:steward test:e2e",
    "gateway": "tsx server/gateway.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@xyflow/react": "^12.10.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.8.9",
    "jsdom": "^28.1.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
